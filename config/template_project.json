            "select_clause": "title, TO_CHAR(start_date,  'Mon DD, YYYY' ) as \"Start Date\", TO_CHAR(end_date,  'Mon DD, YYYY' ) as \"End Date\", t.value as Status",
            "from_clause": "tasks s LEFT JOIN task_statuses t ON s.task_status_id=t.id",
            "where_clause": "level=2",
            "order_clause": "start_date",
            "groupby_clause": "",
            "having_clause": "",
            "published": true
        },
        { 
            "title": "Tasks by assignee",
            "description": "All tasks of the project",
            "select_clause": "u.name as Assignee, s.title, TO_CHAR(s.start_date,'Mon DD, YYYY' ) as \"Start Date\", TO_CHAR(s.end_date,  'Mon DD, YYYY' ) as \"End Date\", t.value as Status",
            "from_clause": "tasks s LEFT JOIN users u ON s.assigned_to=u.id LEFT JOIN task_statuses t ON s.task_status_id=t.id",
            "where_clause": "u.name IS NOT NULL",
            "order_clause": "u.name, t.value",
